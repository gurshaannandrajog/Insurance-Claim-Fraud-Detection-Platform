# Copy to .env (repository root) and fill in. Never commit .env.
# ---------------------------------------------------------------- Django
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIME_ZONE=Asia/Kolkata
# Set to true when served over HTTPS (secure cookies, HSTS, redirect) — REQ-SEC-015
ENABLE_HTTPS=false

# ---------------------------------------------------------------- MySQL
# Quick demo without MySQL: uncomment the next line (uses backend/demo.sqlite3)
# DB_ENGINE=sqlite
DB_NAME=insurance_claims
DB_USER=claims_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# ---------------------------------------------------------------- Email
# Development: console backend prints every email (verification / reset links) in the Django terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Real SMTP (e.g. Gmail app password, Mailtrap, SendGrid):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Insurance Claims <no-reply@example.com>

# ---------------------------------------------------------------- Fraud service (Flask)
FRAUD_SERVICE_URL=http://127.0.0.1:5001
# Shared secret between Django and Flask; both read this same variable
FRAUD_SERVICE_API_KEY=change-me-shared-secret
FRAUD_SERVICE_PORT=5001
FRAUD_ENGINE=rules-v1

# ---------------------------------------------------------------- Business / security settings (SRS defaults)
LOGIN_MAX_FAILED_ATTEMPTS=4
ACCOUNT_LOCK_MINUTES=20
SESSION_INACTIVITY_MINUTES=30
CLAIM_EDIT_WINDOW_MINUTES=30
APPEAL_WINDOW_DAYS=30
MAX_UPLOAD_SIZE_MB=10
THROTTLE_LOGIN=20/min
